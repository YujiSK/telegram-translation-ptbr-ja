{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name as it will appear in the Cloudflare dashboard.
  "name": "telegram-translation-ptbr-ja",
  "main": "src/index.ts",
  // New project: pinned to the date this project was scaffolded.
  // Review before bumping — see https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-08-14",
  // nodejs_compat is intentionally omitted for Phase 0. The health-check
  // scaffold only uses Web-standard APIs. Add it in the phase that first
  // needs a Node.js built-in (for example, an OpenAI SDK that relies on
  // Node APIs), and document why in docs/project-rules.md when it happens.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Non-secret configuration only — see src/config/app-config.ts and
  // docs/security-and-privacy.md. Secrets never go here.
  "vars": {
    "ENVIRONMENT": "development",
    // Fixed model choice — see docs/decisions and docs/architecture.md.
    "OPENAI_MODEL": "gpt-4o-mini",
    // Telegram's own text message limit is 4096 UTF-16 code units; this
    // is a deliberately lower product ceiling (short family-chat
    // messages) to bound OpenAI cost/latency per message. Tune freely —
    // it's read at request time, not baked into any schema.
    "MAX_TRANSLATABLE_MESSAGE_LENGTH": "2000",
  },
  // The remote database exists and 0001_initial.sql has been applied.
  // The Worker has not been deployed. Local commands use local D1 by default.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-translation-ptbr-ja",
      "database_id": "1ff63b78-2be0-43e6-8a80-cbf3edbec2a9",
      "migrations_dir": "migrations",
    },
  ],
}
