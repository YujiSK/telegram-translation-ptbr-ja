{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name as it will appear in the Cloudflare dashboard.
  "name": "telegram-translation-ptbr-ja",
  "main": "src/index.ts",
  // New project: pinned to the date this project was scaffolded.
  // Review before bumping — see https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-08-14",
  // nodejs_compat is intentionally omitted for Phase 0. The health-check
  // scaffold only uses Web-standard APIs. Add it in the phase that first
  // needs a Node.js built-in (for example, an OpenAI SDK that relies on
  // Node APIs), and document why in docs/project-rules.md when it happens.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Non-secret configuration only — see src/config/app-config.ts and
  // docs/security-and-privacy.md. Secrets never go here.
  "vars": {
    "ENVIRONMENT": "development",
    // DeepL-first: deterministic preflight chooses DeepL OR Gemini.
    // workers-ai is the rollback mode; openai retains the legacy path.
    "TRANSLATION_PROVIDER": "deepl",
    // Keep this model and the AI binding for Workers AI rollback.
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // Retained only for TRANSLATION_PROVIDER=openai (legacy/compat path).
    "OPENAI_MODEL": "gpt-4o-mini",
    // Shared Gemini availability switch for deepl and workers-ai modes.
    // Disabled Gemini makes sensitive DeepL-mode input fail closed.
    "GEMINI_ESCALATION_ENABLED": "true",
    // Non-secret model identifier for the Gemini semantic-escalation
    // provider. Only required when GEMINI_ESCALATION_ENABLED is "true".
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // Phase 9.1B app-side Gemini attempt ceilings — deliberately below
    // the observed 15 RPM / 500 RPD free-tier project quota (2026-08-25),
    // leaving headroom rather than claiming a billing guarantee. See
    // docs/phase9-provider-plan.md. Only required when
    // GEMINI_ESCALATION_ENABLED is "true".
    "MAX_GEMINI_ATTEMPTS_PER_MINUTE": "12",
    "MAX_GEMINI_ATTEMPTS_PER_DAY": "450",
    // Telegram's own text message limit is 4096 UTF-16 code units; this
    // is a deliberately lower product ceiling (short family-chat
    // messages) to bound provider cost/latency per message. Tune freely —
    // it's read at request time, not baked into any schema.
    "MAX_TRANSLATABLE_MESSAGE_LENGTH": "2000",
    // Phase 7 reliability/cost limits — see src/config/reliability-config.ts
    // and docs/security-and-privacy.md. Family-scale initial defaults,
    // safe to tune after the Phase 9 pilot; none of these are Secrets.
    // Per allowlisted chat: handled (command + translation) updates per minute.
    "MAX_HANDLED_UPDATES_PER_CHAT_PER_MINUTE": "60",
    // Per chat: OpenAI HTTP attempts (including retries) per minute.
    "MAX_OPENAI_ATTEMPTS_PER_CHAT_PER_MINUTE": "20",
    // Whole bot: OpenAI HTTP attempts (including retries) per UTC day.
    "MAX_OPENAI_ATTEMPTS_PER_DAY": "300",
  },
  // The remote database exists and 0001_initial.sql has been applied.
  // The Worker has not been deployed. Local commands use local D1 by default.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-translation-ptbr-ja",
      "database_id": "1ff63b78-2be0-43e6-8a80-cbf3edbec2a9",
      "migrations_dir": "migrations",
    },
  ],
  // Phase 9.1A: Workers AI binding for the routine translation provider —
  // see src/infrastructure/workers-ai/. Automated tests never perform a
  // real env.AI.run() call (see test doubles in test/infrastructure/workers-ai/);
  // local `wrangler dev` inference can consume real account usage per
  // Cloudflare's documentation, so this binding is not exercised live by
  // `npm run check`.
  "ai": {
    "binding": "AI",
  },
}
